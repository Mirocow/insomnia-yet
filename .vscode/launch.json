{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach electron: Renderer Process",
            "type": "chrome",
            "request": "attach",
            "port": 9223,
            "webRoot": "${workspaceFolder}/packages/insomnia",
            "timeout": 30000
        },
        {
            "name": "Launch electron: main",
            "type": "node",
            "request": "launch",
            "protocol": "inspector",
            "sourceMaps": true,
            "presentation": {
                "hidden": true,
                "group": "Insomnia",
                "order": 1
            },
            "cwd": "${workspaceFolder}/packages/insomnia",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
            "runtimeArgs": ["--remote-debugging-port=9222", "."],
            "outputCapture": "std",
            "windows": {
                "type": "node",
                "request": "launch",
                "name": "Electron: main",
                "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
            },
            "env": {
                "NODE_ENV": "development",
                "ELECTRON_IS_DEV": "1"
            }
        },
        {
            "name": "Launch electron: renderer",
            "type": "pwa-chrome",
            "request": "attach",
            "presentation": {
                "hidden": true,
                "group": "Insomnia",
                "order": 2
            },
            "port": 9222,
            "webRoot": "${workspaceFolder}/packages/insomnia/src",
            "timeout": 60000
        },
        {
            "name": "Launch cli Inso",
            "type": "node",
            "request": "launch",
            "protocol": "inspector",
            "smartStep": true,
            "cwd": "${workspaceFolder}/packages/insomnia-inso",
            "program": "${workspaceFolder}/packages/insomnia-inso/bin/debug_inso",
            "sourceMaps": true,
            "autoAttachChildProcesses": true,
            "trace": true,
            "preLaunchTask": "Inso: Compile (Watch)",
            "args": ["${input:insoCommand}", "${input:insoCommandArgs}"],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "insoCommandArgs",
            "description": "Add an additional argument to inso",
            "type": "promptString"
        },
        {
            "id": "insoCommand",
            "description": "Pick an inso command to run",
            "type": "pickString",
            "options": [
                {
                    "value": "run test"
                },
                {
                    "value": "lint spec"
                },
                {
                    "value": "export spec"
                },
                {
                    "value": "script"
                },
                {
                    "value": "help"
                }
            ]
        }
    ]
}
