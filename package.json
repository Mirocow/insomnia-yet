{
  "name": "insomnia",
  "private": true,
  "version": "1.0.0",
  "author": "Kong <office@konghq.com>",
  "description": "Insomnia is a cross-platform REST client, built on top of Electron.",
  "license": "MIT",
  "repository": "https://github.com/kong/insomnia",
  "bugs": {
    "url": "https://github.com/kong/insomnia/issues"
  },
  "homepage": "https://github.com/kong/insomnia#readme",
  "engines": {
    "node": ">=18.20 <20",
    "npm": ">=8.19.0"
  },
  "workspaces": [
    "packages/openapi-2-kong",
    "packages/insomnia",
    "packages/insomnia-testing"
  ],
  "scripts": {
    "app-package": "npm run package --workspace=packages/insomnia",
    "app-build": "npm run build --workspace=packages/insomnia",
    "clean": "git clean -dfX",
    "watch:app": "npm run build:main.min.js --workspace=packages/insomnia && npm run start:dev-server --workspace=packages/insomnia",
    "changelog-image": "esr ./scripts/changelog-image/changelog-image.ts",
    "download-all-npm-plugins": "esr ./scripts/download-all-npm-plugins.ts",
    "dev": "npm run start --workspace=packages/insomnia",
    "dev-debug": "npm run start-debug --workspace=packages/insomnia",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint:markdown": "npx markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@jest/globals": "^28.1.0",
    "@jest/types": "^28.1.0",
    "@types/chai": "^4.3.14",
    "@types/eslint": "^8.56.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.4",
    "@types/svgo": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "esbuild": "^0.24.0",
    "esbuild-runner": "^2.2.2",
    "eslint": "^8.57.1",
    "eslint-config-helpers": "^1.2.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-html": "^8.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "esr": "^0.10.0",
    "jest": "^28.1.0",
    "sr": "^1.0.4",
    "svg-text-to-path": "^1.1.2",
    "svgo": "^2.8.0",
    "ts-jest": "^28.0.1",
    "tslib": "^2.1.0",
    "type-fest": "^4.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "dependencies": {
    "@types/decompress": "^4.2.7",
    "decompress": "^4.2.1"
  }
}
